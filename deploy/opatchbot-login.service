[Unit]
Description=opatchbot weekly unattended re-login (keeps the Oracle session fresh)
After=network-online.target

[Service]
Type=oneshot
User=oracle
Environment=OPATCHBOT_CONFIG=/opt/app/patch/config.yaml
Environment=OPATCHBOT_SECRETS=/home/oracle/.mos/secrets.env
UnsetEnvironment=LD_LIBRARY_PATH
ExecStart=/opt/app/patch/venv/bin/opatchbot login
