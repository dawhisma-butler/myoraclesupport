# /etc/systemd/system/mos-patch-sync.service
# One-shot run of the MOS PeopleTools patch sync as user oracle.
# Test now:  sudo systemctl start mos-patch-sync.service
# Logs:      /opt/app/patch/logs/mos-patch-sync.log  (and: journalctl -u mos-patch-sync)
[Unit]
Description=Download newest PeopleTools patch from My Oracle Support
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=oracle
Environment=HOME=/home/oracle
Environment=APP_HOME=/opt/app/patch
Environment=MOS_DIR=/home/oracle/.mos
Environment=MOS_OUTDIR=/opt/data2/download/patch
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/app/patch
ExecStart=/bin/bash /opt/app/patch/weekly_sync.sh
TimeoutStartSec=6h
Nice=10
