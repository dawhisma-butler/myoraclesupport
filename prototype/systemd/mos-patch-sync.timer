# /etc/systemd/system/mos-patch-sync.timer
# Runs mos-patch-sync.service every Monday at 06:00 (server local time).
# Enable:  sudo systemctl enable --now mos-patch-sync.timer
# Check:   systemctl list-timers mos-patch-sync.timer
# Remove:  sudo systemctl disable --now mos-patch-sync.timer
[Unit]
Description=Weekly MOS PeopleTools patch sync

[Timer]
OnCalendar=Mon *-*-* 06:00:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
